# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example for MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/applypilot?retryWrites=true&w=majority
# Example for local MongoDB: mongodb://127.0.0.1:27017/applypilot
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/applypilot?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=applypilot_super_secret_jwt_token_key_change_in_production
JWT_EXPIRES_IN=7d
